config GNSS_QUECTEL_EG915N
	bool "Quectel EG915N GNSS driver"
	default y
	depends on GNSS
	depends on DT_HAS_QUECTEL_EG915N_GNSS_ENABLED
	depends on MODEM_CELLULAR
	depends on GNSS_REFERENCE_FRAME_WGS84
	select MODEM_MODULES
	select MODEM_CHAT
	select MODEM_PIPE
	select MODEM_PIPELINK
	select GNSS_PARSE
	select GNSS_NMEA0183
	select GNSS_NMEA0183_MATCH
	help
	  GNSS receiver integrated in the Quectel EG915N modem, driven by
	  polling the modem over one of its CMUX channels.

if GNSS_QUECTEL_EG915N

config GNSS_QUECTEL_EG915N_INIT_PRIORITY
	int "Quectel EG915N GNSS driver initialization priority"
	default 92
	range 0 99
	help
	  Must be greater than MODEM_CELLULAR_INIT_PRIORITY, because the modem
	  driver creates the pipe this driver attaches to.

config GNSS_QUECTEL_EG915N_SATELLITES_COUNT
	int "Maximum satellite count"
	depends on GNSS_SATELLITES
	default 24
	help
	  Maximum number of satellites that can be decoded from the GSV
	  sentences reported by the modem. This does not affect how many
	  satellites the modem tracks, only how many can be reported in the
	  satellites callback.

endif # GNSS_QUECTEL_EG915N
